# ==============================================================================
# PROJETO LUMINA - .gitignore
# Configuração para evitar envio de bases brutas e arquivos pesados (> 100MB)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BASES BRUTAS E ARQUIVOS PESADOS DO SISAGUA (Gigabytes)
# ------------------------------------------------------------------------------
# Ignora pastas com bases brutas não tratadas
**/Arquivos de Controle (sem tratamento)/**
**/Arquivos de Controle (sem tratamento)/*
controle_semestral_2026_csv/

# Ignora arquivos específicos de grande volume
*.zip
*.tar.gz
*.rar
*.7z

# Ignora dumps e arquivos brutos grandes em JSON
*.json
!package.json
!tsconfig.json

# ------------------------------------------------------------------------------
# 2. FORMATOS DE DADOS E TABELAS (Prevenção geral)
# ------------------------------------------------------------------------------
# Se desejar ignorar TODOS os CSVs grandes descomente a linha abaixo:
# *.csv

# Se quiser permitir APENAS os CSVs pequenos tratados (ex: pasta Tratado):
# *.csv
# !**/Tratado*/*.csv

*.parquet
*.feather
*.h5
*.hdf5
*.pkl
*.pickle
*.sqlite
*.sqlite3
*.db

# ------------------------------------------------------------------------------
# 3. AMBIENTES PYTHON, JUPYTER NOTEBOOKS E CACHE
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.ipynb_checkpoints/
*-checkpoint.ipynb

# Ambientes virtuais
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# ------------------------------------------------------------------------------
# 4. SISTEMA OPERACIONAL E EDIDORES
# ------------------------------------------------------------------------------
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# VS Code / IDEs
.vscode/
.idea/
